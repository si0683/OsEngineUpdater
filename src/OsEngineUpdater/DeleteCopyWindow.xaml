<Window x:Class="OsEngineUpdater.DeleteCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Удалить копию" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI" FontSize="13" Loaded="Window_Loaded" Closing="Window_Closing">
    <Border Style="{StaticResource Card}" Margin="12">
        <StackPanel>
            <TextBlock x:Name="TxtTitle" Style="{StaticResource H2}" FontSize="16" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtPath" Style="{StaticResource Dim}" FontSize="13"/>
            <TextBlock x:Name="TxtSize" Style="{StaticResource Dim}" Margin="0,2,0,12"/>

            <Border Background="#33F0554F" BorderBrush="{StaticResource Bad}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                <TextBlock TextWrapping="Wrap">
                    Будет удалена <Bold>вся папка</Bold>, включая ваших роботов, индикаторы, настройки и данные внутри неё.
                    Папка отправится в Корзину; автообновление этой копии выключится.
                </TextBlock>
            </Border>

            <StackPanel x:Name="PanelBlockers" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock Text="Удалить сейчас нельзя:" Foreground="{StaticResource Warn}" FontWeight="SemiBold"/>
                <ItemsControl x:Name="ListBlockers" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Foreground="{StaticResource Warn}" Margin="0,2,0,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Проверить снова" Click="BtnRecheck_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>

            <TextBlock x:Name="TxtConfirmHint" Margin="0,14,0,6" TextWrapping="Wrap"/>
            <TextBox x:Name="TxtConfirm" TextChanged="TxtConfirm_TextChanged"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="BtnDelete" Content="Удалить копию" IsEnabled="False" Click="BtnDelete_Click"
                        Background="{StaticResource Bad}" BorderBrush="{StaticResource Bad}" Foreground="White" FontWeight="SemiBold"/>
                <Button Content="Отмена" IsCancel="True" Margin="0,0,0,8"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
