<UserControl x:Class="OsEngineUpdater.AccountBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- аккаунт GitHub или GitFlic: адрес (или логин), токен, инструкция, проверка -->
    <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="12,10,12,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.ColumnSpan="2" x:Name="TxtHeader" Style="{StaticResource H2}" FontSize="14" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" Text="Аккаунт" Style="{StaticResource Label}"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtAccount" TextChanged="Field_Changed"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtDetected" Style="{StaticResource Dim}" Margin="0,4,0,0"/>

            <TextBlock Grid.Row="3" Text="Токен" Style="{StaticResource Label}" Margin="0,10,10,0"/>
            <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="PwdToken" Margin="0,10,0,0" PasswordChanged="Field_Changed"/>
            <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,4,0,0">
                <TextBlock x:Name="TxtTokenHint" Style="{StaticResource Dim}"/>
                <Button x:Name="BtnHowToken" Style="{StaticResource LinkButton}" Click="BtnHowToken_Click" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Row="5" Grid.ColumnSpan="2" x:Name="PanelHowToken" Visibility="Collapsed" Margin="0,8,0,0"
                    Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="12,10">
                <StackPanel>
                    <TextBlock x:Name="TxtHowToken" TextWrapping="Wrap" LineHeight="20"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="BtnOpenTokenPage" Click="BtnOpenTokenPage_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnOpenTokenPage2" Click="BtnOpenTokenPage_Click" Margin="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DockPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,12,0,0">
                <Button DockPanel.Dock="Left" x:Name="BtnTest" Content="Проверить" Click="BtnTest_Click" Margin="0,0,10,0" VerticalAlignment="Top"/>
                <TextBlock x:Name="TxtTest" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
