<Window x:Class="OsEngineUpdater.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OsEngine Updater" Icon="Assets/app.ico" Width="500" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Topmost="True"
        Foreground="{StaticResource Fg}" FontFamily="Segoe UI" FontSize="13"
        Opacity="0" Loaded="Window_Loaded">
    <Grid Margin="20" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Scale" ScaleX="0.96" ScaleY="0.96"/>
        </Grid.RenderTransform>

        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="Black"/>
            </Border.Effect>
        </Border>

        <Grid>
            <Grid.Clip>
                <RectangleGeometry x:Name="CardClip" RadiusX="10" RadiusY="10"/>
            </Grid.Clip>

            <!-- мягкое свечение акцентом в углу -->
            <Ellipse Width="340" Height="340" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-180,-150,0" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#40FF5A00" Offset="0"/>
                        <GradientStop Color="#00FF5A00" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- акцентная линия сверху -->
            <Border Height="3" VerticalAlignment="Top" Background="{StaticResource Accent}"/>

            <Grid Margin="32,34,32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="64" Height="64" CornerRadius="14" Background="{StaticResource Panel2}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <Image Source="Assets/app.ico" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="OsEngine Updater" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="Обновление копий OsEngine и своих роботов" Foreground="{StaticResource FgDim}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock x:Name="TxtVersion" DockPanel.Dock="Right" Foreground="{StaticResource FgDim}" FontSize="12"/>
                        <TextBlock x:Name="TxtStatus" Text="Ищу копии OsEngine…" Foreground="{StaticResource FgDim}" FontSize="12"/>
                    </DockPanel>

                    <!-- бегущая полоска загрузки -->
                    <Border x:Name="Track" Height="3" CornerRadius="1.5" Background="{StaticResource Panel2}" ClipToBounds="True">
                        <Border x:Name="Runner" Width="140" HorizontalAlignment="Left" CornerRadius="1.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FF5A00" Offset="0"/>
                                    <GradientStop Color="#FFFF5A00" Offset="0.5"/>
                                    <GradientStop Color="#00FF5A00" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="RunnerShift" X="-140"/>
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
