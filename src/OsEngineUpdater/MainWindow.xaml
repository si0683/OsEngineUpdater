<Window x:Class="OsEngineUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OsEngine Updater" Icon="Assets/app.ico" Width="1200" Height="780" MinWidth="1190" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI" FontSize="13"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColCopies" Width="290" MinWidth="270" MaxWidth="520"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GridSplitter Grid.Column="1" x:Name="SplitCopies" Style="{StaticResource Splitter}"
                      DragCompleted="Splitter_DragCompleted" MouseDoubleClick="SplitCopies_DoubleClick"/>

        <!-- копии -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Копии OsEngine" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
                    <ComboBox DockPanel.Dock="Right" x:Name="CmbWatch" Width="112" SelectionChanged="CmbWatch_SelectionChanged"
                              ToolTip="Как часто проверять GitHub и обновлять копии с включённым авто — и в окне, и в Планировщике, когда окно закрыто">
                        <ComboBoxItem Tag="10" Content="10 мин"/>
                        <ComboBoxItem Tag="30" Content="30 мин"/>
                        <ComboBoxItem Tag="60" Content="час"/>
                        <ComboBoxItem Tag="360" Content="6 часов"/>
                        <ComboBoxItem Tag="1440" Content="сутки"/>
                    </ComboBox>
                    <TextBlock Text="Автообновление" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="TxtWatch" Style="{StaticResource Dim}" Margin="0,0,0,10"/>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button x:Name="BtnAddCopy" Content="Добавить копию…" Click="BtnAddCopy_Click" Margin="0,0,0,6"
                            ToolTip="Указать папку существующей копии OsEngine"/>
                    <Button x:Name="BtnNewCopy" Content="Создать новую копию…" Click="BtnNewCopy_Click" Margin="0,0,0,6"
                            ToolTip="Скачать свежую копию OsEngine из GitHub в пустую папку"/>
                    <Button x:Name="BtnDeleteCopy" Content="Удалить копию…" Click="BtnDeleteCopy_Click" Margin="0"
                            ToolTip="Удалить папку копии с диска (в Корзину) и выключить её автообновление"/>
                    <TextBlock x:Name="TxtAppVersion" Style="{StaticResource Dim}" FontSize="11" Margin="2,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <ListBox x:Name="CopiesList" SelectionChanged="CopiesList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Root}" Style="{StaticResource Dim}" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Root}"/>
                                <TextBlock Text="{Binding Summary}" Foreground="{Binding SummaryBrush}" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="2" x:Name="RightPanel" SizeChanged="Panes_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- статус -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
                        <TextBlock x:Name="TxtCopyName" FontSize="18" FontWeight="SemiBold" Text="—"/>
                        <TextBlock x:Name="TxtCopyRoot" Style="{StaticResource Dim}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="ВЕРСИЯ КОПИИ" Style="{StaticResource Dim}" FontSize="11"/>
                        <TextBlock x:Name="TxtVersion" FontSize="14" Margin="0,4,0,0" Text="—"/>
                        <TextBlock x:Name="TxtVersionDate" Style="{StaticResource Dim}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="GITHUB" Style="{StaticResource Dim}" FontSize="11"/>
                        <TextBlock x:Name="TxtBehind" FontSize="14" Margin="0,4,0,0" Text="—"/>
                        <TextBlock x:Name="TxtBehindHint" Style="{StaticResource Dim}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Text="АВТООБНОВЛЕНИЕ" Style="{StaticResource Dim}" FontSize="11"/>
                        <TextBlock x:Name="TxtAuto" FontSize="14" Margin="0,4,0,0" Text="—"/>
                        <TextBlock x:Name="TxtAutoDetails" Style="{StaticResource Dim}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- действия -->
            <StackPanel Grid.Row="1" Margin="0,12,0,4">
            <WrapPanel VerticalAlignment="Center">
                <Button x:Name="BtnUpdate" Content="Обновить сейчас" Style="{StaticResource AccentButton}" Click="BtnUpdate_Click"
                        ToolTip="Полная сверка с репозиторием (Mirror): добавить, обновить и удалить официальные файлы"/>
                <Button x:Name="BtnCheck" Content="Проверить" Click="BtnCheck_Click"
                        ToolTip="Показать, что изменится, ничего не меняя"/>
                <Button x:Name="BtnAuto" Content="Включить авто" Click="BtnAuto_Click"/>
                <Button x:Name="BtnFull" Content="Полная перекачка" Click="BtnFull_Click"
                        ToolTip="Скачать архив репозитория (~200 МБ) и перезаписать все официальные файлы"/>
                <Button x:Name="BtnVs" Content="Обновить VS" Click="BtnVs_Click"
                        ToolTip="Заставить Visual Studio показать файлы, добавленные в Robots/Indicators"/>
                <Button x:Name="BtnOpenFolder" Content="Папка копии" Click="BtnOpenFolder_Click"/>
                <Button x:Name="BtnCancel" Content="Отмена" Click="BtnCancel_Click" IsEnabled="False"/>
            </WrapPanel>
            <CheckBox x:Name="ChkForce" Content="Даже если OsEngine запущен" Margin="2,0,0,10" HorizontalAlignment="Left"
                      ToolTip="Обычно обновление пропускается, пока OsEngine этой копии открыт (файлы bin заняты)"/>
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Моя разработка:" Style="{StaticResource Label}" Margin="0,0,10,8"/>
                <Button x:Name="BtnPickRobot" Content="Выбрать робот…" Click="BtnPickRobot_Click" ToolTipService.ShowOnDisabled="True"/>
                <Button x:Name="BtnPickIndicator" Content="Выбрать индикатор…" Click="BtnPickIndicator_Click" ToolTipService.ShowOnDisabled="True"/>
                <Button x:Name="BtnPickFiles" Content="Свои файлы…" Click="BtnPickFiles_Click" ToolTipService.ShowOnDisabled="True"/>
                <Button x:Name="BtnRepos" Content="Мои аккаунты и репозитории…" Click="BtnRepos_Click"
                        ToolTip="Свои репозитории GitHub / GitFlic с роботами, индикаторами и файлами (общие для всех копий)"/>
            </WrapPanel>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColSettings" Width="410" MinWidth="380"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GridSplitter Grid.Column="1" x:Name="SplitLog" Style="{StaticResource Splitter}"
                              DragCompleted="Splitter_DragCompleted" MouseDoubleClick="SplitLog_DoubleClick"/>

                <!-- настройки -->
                <Border Style="{StaticResource Card}" Padding="14,14,6,14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Настройки копии" Style="{StaticResource H2}"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,8,0">
                            <Button x:Name="BtnSave" Content="Сохранить" Style="{StaticResource AccentButton}" Click="BtnSave_Click" Margin="0,0,8,0"/>
                            <Button x:Name="BtnRevert" Content="Отменить" Click="BtnRevert_Click" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtDirty" VerticalAlignment="Center" Style="{StaticResource Dim}"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                            <!-- одна колонка: заголовок поля, под ним поле, под ним пояснение -->
                            <StackPanel x:Name="SettingsGrid">
                                <TextBlock Text="Как вы запускаете OsEngine?" Style="{StaticResource FieldTitle}"/>
                                <ComboBox x:Name="CmbProfile" SelectionChanged="AnySetting_Changed">
                                    <ComboBoxItem Tag="Prebuilt" Content="Готовый OsEngine.exe"/>
                                    <ComboBoxItem Tag="FromSource" Content="Собираю сам в Visual Studio"/>
                                </ComboBox>
                                <TextBlock x:Name="TxtProfileHint" Style="{StaticResource Dim}" Margin="0,6,0,0"/>

                                <TextBlock Text="Какие файлы не перезаписывать?" Style="{StaticResource FieldTitle}" Margin="0,20,0,6"/>
                                <Border Background="{StaticResource Input}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3"
                                        MinHeight="34" MaxHeight="120">
                                    <Grid>
                                        <!-- строки с галочками: щелчок по строке ставит/снимает галочку, «Убрать» убирает отмеченные -->
                                        <ListBox x:Name="LstProtected" Margin="3" SelectionMode="Single"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 KeyDown="LstProtected_KeyDown">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                    <EventSetter Event="MouseLeftButtonUp" Handler="ProtectedRow_Click"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="6,4" Cursor="Hand">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}"/>
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel2}"/>
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel ToolTip="{Binding Pattern}" Background="Transparent">
                                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked, Mode=TwoWay}" Focusable="False" Margin="0,0,8,0"/>
                                                        <Path x:Name="Ico" DockPanel.Dock="Left" Style="{StaticResource ItemIcon}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter TargetName="Ico" Property="Data" Value="{StaticResource IconFolder}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsMask}" Value="True">
                                                            <Setter TargetName="Ico" Property="Data" Value="{StaticResource IconMask}"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="TxtProtectedEmpty" Text="пусто — обновляются все файлы"
                                                   Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                                <UniformGrid Rows="1" Margin="0,6,-6,0">
                                    <Button Content="+ Файл…" ToolTip="Выбрать официальные файлы, которые не нужно перезаписывать" Click="BtnProtectFile_Click" Padding="4,2" MinHeight="26" Margin="0,0,6,0"/>
                                    <Button Content="+ Папка…" ToolTip="Выбрать папки: всё внутри них не будет перезаписываться" Click="BtnProtectFolder_Click" Padding="4,2" MinHeight="26" Margin="0,0,6,0"/>
                                    <Button x:Name="BtnProtectRemove" Content="Убрать" Click="BtnProtectRemove_Click" Padding="4,2" MinHeight="26" Margin="0,0,6,0"/>
                                </UniformGrid>
                                <TextBlock Style="{StaticResource Dim}" Margin="0,2,0,0"
                                           Text="Официальные файлы OsEngine, которые вы изменили сами: обновление их не перезапишет. Свои новые файлы и папки добавлять не нужно — они и так не трогаются."/>

                                <Button x:Name="BtnAdvanced" Content="Дополнительно ▸" Click="BtnAdvanced_Click"
                                        HorizontalAlignment="Left" Padding="10,2" MinHeight="26" Margin="0,20,0,0"
                                        ToolTip="Источник обновлений, токен GitHub и папки для своих роботов. Обычно менять не нужно."/>

                                <StackPanel x:Name="AdvancedGrid" Visibility="Collapsed" Margin="0,8,0,0">
                                    <TextBlock Text="Источник обновлений" Style="{StaticResource FieldTitle}" Margin="0,8,0,2"/>
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,8"
                                               Text="Откуда брать OsEngine на GitHub. Менять нужно, только если обновляетесь из своего форка."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Владелец" Style="{StaticResource Dim}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtOwner" TextChanged="AnySetting_Changed" ToolTip="Owner: AlexWan"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Репозиторий" Style="{StaticResource Dim}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtRepo" TextChanged="AnySetting_Changed" ToolTip="Repo: OsEngine"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Ветка" Style="{StaticResource Dim}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtBranch" TextChanged="AnySetting_Changed" ToolTip="Branch: master"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Токен GitHub" Style="{StaticResource FieldTitle}" Margin="0,16,0,6"/>
                                    <PasswordBox x:Name="PwdToken" PasswordChanged="AnySetting_Changed"/>
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0"
                                               Text="Необязательно. Без токена GitHub даёт 60 запросов в час на компьютер — при нескольких копиях с частым авто лучше указать."/>

                                    <TextBlock Text="Папка роботов" Style="{StaticResource FieldTitle}" Margin="0,16,0,6"/>
                                    <TextBox x:Name="TxtRobotsDir" TextChanged="AnySetting_Changed"
                                             ToolTip="Относительно корня копии. По умолчанию project\OsEngine\Robots"/>
                                    <TextBlock Text="Папка индикаторов" Style="{StaticResource FieldTitle}" Margin="0,12,0,6"/>
                                    <TextBox x:Name="TxtIndicatorsDir" TextChanged="AnySetting_Changed"
                                             ToolTip="Относительно корня копии. По умолчанию project\OsEngine\Indicators"/>
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0"
                                               Text="Сюда ставятся роботы и индикаторы из ваших репозиториев: каждый в подпапку с именем репозитория."/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- лог -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Открыть лог" Click="BtnOpenLog_Click" Margin="0" Padding="10,2" MinHeight="26"/>
                            <TextBlock x:Name="TxtLogTitle" Text="Лог" Style="{StaticResource H2}" Margin="0,0,10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBox x:Name="TxtLog" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 Background="{StaticResource Input}"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
