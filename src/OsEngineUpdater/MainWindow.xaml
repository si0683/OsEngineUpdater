<Window x:Class="OsEngineUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OsEngine Updater" Icon="Assets/app.ico" Width="1200" Height="780" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI" FontSize="13"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- копии -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Копии OsEngine" Style="{StaticResource H2}"/>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button x:Name="BtnAddCopy" Content="Добавить копию…" Click="BtnAddCopy_Click" Margin="0,0,0,6"
                            ToolTip="Указать папку существующей копии OsEngine"/>
                    <Button x:Name="BtnNewCopy" Content="Создать новую копию…" Click="BtnNewCopy_Click" Margin="0,0,0,6"
                            ToolTip="Скачать свежую копию OsEngine из GitHub в пустую папку"/>
                    <Button x:Name="BtnDeleteCopy" Content="Удалить копию…" Click="BtnDeleteCopy_Click" Margin="0"
                            ToolTip="Удалить папку копии с диска (в Корзину) и выключить её автообновление"/>
                </StackPanel>
                <ListBox x:Name="CopiesList" SelectionChanged="CopiesList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Root}" Style="{StaticResource Dim}" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Root}"/>
                                <TextBlock Text="{Binding Summary}" Foreground="{Binding SummaryBrush}" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="2" x:Name="RightPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- статус -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
                        <TextBlock x:Name="TxtCopyName" FontSize="18" FontWeight="SemiBold" Text="—"/>
                        <TextBlock x:Name="TxtCopyRoot" Style="{StaticResource Dim}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="ВЕРСИЯ КОПИИ" Style="{StaticResource Dim}" FontSize="11"/>
                        <TextBlock x:Name="TxtVersion" FontSize="14" Margin="0,4,0,0" Text="—"/>
                        <TextBlock x:Name="TxtVersionDate" Style="{StaticResource Dim}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="GITHUB" Style="{StaticResource Dim}" FontSize="11"/>
                        <TextBlock x:Name="TxtBehind" FontSize="14" Margin="0,4,0,0" Text="—"/>
                        <TextBlock x:Name="TxtBehindHint" Style="{StaticResource Dim}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Text="АВТООБНОВЛЕНИЕ" Style="{StaticResource Dim}" FontSize="11"/>
                        <TextBlock x:Name="TxtAuto" FontSize="14" Margin="0,4,0,0" Text="—"/>
                        <TextBlock x:Name="TxtAutoDetails" Style="{StaticResource Dim}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- действия -->
            <StackPanel Grid.Row="1" Margin="0,12,0,4">
            <WrapPanel VerticalAlignment="Center">
                <Button x:Name="BtnUpdate" Content="Обновить сейчас" Style="{StaticResource AccentButton}" Click="BtnUpdate_Click"
                        ToolTip="Полная сверка с репозиторием (Mirror): добавить, обновить и удалить официальные файлы"/>
                <Button x:Name="BtnCheck" Content="Проверить" Click="BtnCheck_Click"
                        ToolTip="Показать, что изменится, ничего не меняя"/>
                <Button x:Name="BtnAuto" Content="Включить авто" Click="BtnAuto_Click"/>
                <Button x:Name="BtnFull" Content="Полная перекачка" Click="BtnFull_Click"
                        ToolTip="Скачать архив репозитория (~200 МБ) и перезаписать все официальные файлы"/>
                <Button x:Name="BtnVs" Content="Обновить VS" Click="BtnVs_Click"
                        ToolTip="Заставить Visual Studio показать файлы, добавленные в Robots/Indicators"/>
                <Button x:Name="BtnOpenFolder" Content="Папка копии" Click="BtnOpenFolder_Click"/>
                <Button x:Name="BtnCancel" Content="Отмена" Click="BtnCancel_Click" IsEnabled="False"/>
                <CheckBox x:Name="ChkForce" Content="Даже если OsEngine запущен" Margin="6,0,0,8"
                          ToolTip="Обычно обновление пропускается, пока OsEngine этой копии открыт (файлы bin заняты)"/>
            </WrapPanel>
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Моя разработка:" Style="{StaticResource Label}" Margin="0,0,10,8"/>
                <Button x:Name="BtnPickRobot" Content="Выбрать робот…" Click="BtnPickRobot_Click" ToolTipService.ShowOnDisabled="True"/>
                <Button x:Name="BtnPickIndicator" Content="Выбрать индикатор…" Click="BtnPickIndicator_Click" ToolTipService.ShowOnDisabled="True"/>
                <Button x:Name="BtnPickFiles" Content="Свои файлы…" Click="BtnPickFiles_Click" ToolTipService.ShowOnDisabled="True"/>
                <Button x:Name="BtnRepos" Content="Мои аккаунты и репозитории…" Click="BtnRepos_Click"
                        ToolTip="Свои репозитории GitHub / GitFlic с роботами, индикаторами и файлами (общие для всех копий)"/>
            </WrapPanel>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="410"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- настройки -->
                <Border Style="{StaticResource Card}" Padding="14,14,6,14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Настройки копии" Style="{StaticResource H2}"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,8,0">
                            <Button x:Name="BtnSave" Content="Сохранить" Style="{StaticResource AccentButton}" Click="BtnSave_Click" Margin="0,0,8,0"/>
                            <Button x:Name="BtnRevert" Content="Отменить" Click="BtnRevert_Click" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtDirty" VerticalAlignment="Center" Style="{StaticResource Dim}"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                            <Grid x:Name="SettingsGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Профиль" Style="{StaticResource Label}"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbProfile" SelectionChanged="AnySetting_Changed">
                                    <ComboBoxItem Tag="Prebuilt" Content="Prebuilt — готовый движок"/>
                                    <ComboBoxItem Tag="FromSource" Content="FromSource — собираю сам"/>
                                </ComboBox>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtProfileHint" Style="{StaticResource Dim}" Margin="0,4,0,10"/>

                                <TextBlock Grid.Row="2" Text="Сборка после" Style="{StaticResource Label}"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CmbBuild" SelectionChanged="AnySetting_Changed">
                                    <ComboBoxItem Tag="auto" Content="По профилю"/>
                                    <ComboBoxItem Tag="yes" Content="Всегда собирать"/>
                                    <ComboBoxItem Tag="no" Content="Не собирать"/>
                                </ComboBox>

                                <TextBlock Grid.Row="3" Text="Команда сборки" Style="{StaticResource Label}" Margin="0,10,10,0"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtBuildCommand" Margin="0,10,0,0" TextChanged="AnySetting_Changed"
                                         ToolTip="Пусто — dotnet build &quot;project\OsEngine\OsEngine.csproj&quot; -c Debug"/>

                                <TextBlock Grid.Row="4" Text="Режим авто" Style="{StaticResource Label}" Margin="0,16,10,0"/>
                                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="CmbMode" Margin="0,16,0,0" SelectionChanged="AnySetting_Changed">
                                    <ComboBoxItem Tag="Mirror" Content="Mirror — полная сверка"/>
                                    <ComboBoxItem Tag="Delta" Content="Delta — только изменения"/>
                                </ComboBox>

                                <TextBlock Grid.Row="5" Text="Интервал авто" Style="{StaticResource Label}" Margin="0,10,10,0"/>
                                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBox x:Name="TxtInterval" Width="70" TextChanged="AnySetting_Changed"/>
                                    <TextBlock Text="мин" Style="{StaticResource Label}" Margin="8,0,10,0"/>
                                    <Button Content="1 ч" Tag="60" Click="IntervalPreset_Click" Padding="8,2" MinHeight="26" Margin="0,0,4,0"/>
                                    <Button Content="6 ч" Tag="360" Click="IntervalPreset_Click" Padding="8,2" MinHeight="26" Margin="0,0,4,0"/>
                                    <Button Content="сутки" Tag="1440" Click="IntervalPreset_Click" Padding="8,2" MinHeight="26" Margin="0"/>
                                </StackPanel>

                                <TextBlock Grid.Row="6" Text="Свои исключения" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,16,10,0"/>
                                <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,16,0,0">
                                    <TextBox x:Name="TxtProtected" AcceptsReturn="True" Height="78" VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas"
                                             TextChanged="AnySetting_Changed"/>
                                    <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0"
                                               Text="По одной маске в строке, напр. project/OsEngine/Robots/MyBot.cs или **/Custom/**. Эти официальные файлы не будут перезаписываться."/>
                                </StackPanel>

                                <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="Источник (GitHub)" Style="{StaticResource H2}" FontSize="13" Margin="0,18,0,8"/>

                                <TextBlock Grid.Row="8" Text="Owner" Style="{StaticResource Label}"/>
                                <TextBox Grid.Row="8" Grid.Column="1" x:Name="TxtOwner" TextChanged="AnySetting_Changed"/>
                                <TextBlock Grid.Row="9" Text="Repo" Style="{StaticResource Label}" Margin="0,6,10,0"/>
                                <TextBox Grid.Row="9" Grid.Column="1" x:Name="TxtRepo" Margin="0,6,0,0" TextChanged="AnySetting_Changed"/>
                                <TextBlock Grid.Row="10" Text="Branch" Style="{StaticResource Label}" Margin="0,6,10,0"/>
                                <TextBox Grid.Row="10" Grid.Column="1" x:Name="TxtBranch" Margin="0,6,0,0" TextChanged="AnySetting_Changed"/>
                                <TextBlock Grid.Row="11" Text="Токен" Style="{StaticResource Label}" Margin="0,6,10,0"/>
                                <PasswordBox Grid.Row="11" Grid.Column="1" x:Name="PwdToken" Margin="0,6,0,0" PasswordChanged="AnySetting_Changed"/>
                                <TextBlock Grid.Row="12" Grid.Column="1" Style="{StaticResource Dim}" Margin="0,4,0,0"
                                           Text="Необязательно. Без токена GitHub даёт 60 запросов в час на компьютер — при нескольких копиях с частым авто лучше указать."/>

                                <TextBlock Grid.Row="13" Grid.ColumnSpan="2" Text="Моя разработка" Style="{StaticResource H2}" FontSize="13" Margin="0,18,0,8"/>
                                <TextBlock Grid.Row="14" Text="Папка роботов" Style="{StaticResource Label}"/>
                                <TextBox Grid.Row="14" Grid.Column="1" x:Name="TxtRobotsDir" TextChanged="AnySetting_Changed"
                                         ToolTip="Относительно корня копии. По умолчанию project\OsEngine\Robots"/>
                                <TextBlock Grid.Row="15" Text="Папка индикаторов" Style="{StaticResource Label}" Margin="0,6,10,0"/>
                                <TextBox Grid.Row="15" Grid.Column="1" x:Name="TxtIndicatorsDir" Margin="0,6,0,0" TextChanged="AnySetting_Changed"
                                         ToolTip="Относительно корня копии. По умолчанию project\OsEngine\Indicators"/>
                                <TextBlock Grid.Row="16" Grid.Column="1" Style="{StaticResource Dim}" Margin="0,4,0,0"
                                           Text="Сюда ставятся роботы и индикаторы из ваших репозиториев: каждый в подпапку с именем репозитория."/>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- лог -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Открыть лог" Click="BtnOpenLog_Click" Margin="0" Padding="10,2" MinHeight="26"/>
                            <TextBlock x:Name="TxtLogTitle" Text="Лог" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBox x:Name="TxtLog" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 Background="{StaticResource Input}"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
