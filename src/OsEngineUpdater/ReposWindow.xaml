<Window x:Class="OsEngineUpdater.ReposWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OsEngineUpdater"
        Title="Мои аккаунты и репозитории" Width="1000" Height="880" MinWidth="820" MinHeight="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI" FontSize="13" Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- записи -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Аккаунты" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Dim}" Margin="0,0,0,10"
                           Text="В каждой записи — GitHub, GitFlic или оба. Несколько аккаунтов — несколько записей."/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Добавить" Click="BtnAdd_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnRemove" Content="Удалить из списка" Click="BtnRemove_Click" Margin="0"/>
                </StackPanel>
                <ListBox x:Name="EntriesList" SelectionChanged="EntriesList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Dim}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- выбранная запись: GitHub и GitFlic -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel x:Name="RecordPanel">
                <TextBlock DockPanel.Dock="Top" x:Name="TxtRecordTitle" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Dim}" Margin="0,0,0,10"
                           Text="Заполните GitHub, GitFlic или оба. Всё из аккаунтов появится в окнах «Выбрать робот / индикатор / Свои файлы»."/>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Dim}" Margin="0,10,0,0"
                           Text="Токены хранятся зашифрованными для вашей учётной записи Windows."/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <local:AccountBlock x:Name="BlockGitHub" Changed="Block_Changed"/>
                        <local:AccountBlock x:Name="BlockGitFlic" Changed="Block_Changed" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- обновление самой программы -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Обновление программы" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ChkSelfUpdate" Content="Обновлять OsEngine Updater автоматически, проверять" Click="SelfSetting_Changed"/>
                        <ComboBox x:Name="CmbSelfMinutes" Width="104" Margin="10,0,0,0" SelectionChanged="SelfSetting_Changed">
                            <ComboBoxItem Tag="10" Content="10 мин"/>
                            <ComboBoxItem Tag="30" Content="30 мин"/>
                            <ComboBoxItem Tag="60" Content="час"/>
                            <ComboBoxItem Tag="360" Content="6 часов"/>
                            <ComboBoxItem Tag="1440" Content="сутки"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock x:Name="TxtSelfInfo" Style="{StaticResource Dim}" Margin="0,8,0,0"/>
                    <TextBlock x:Name="TxtSelfStatus" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="BtnSelfCheck" Content="Проверить сейчас" Click="BtnSelfCheck_Click" Margin="0,0,0,6"/>
                    <Button x:Name="BtnSelfInstall" Content="Обновить и перезапустить" Style="{StaticResource AccentButton}"
                            Click="BtnSelfInstall_Click" Visibility="Collapsed" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="TxtGit" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,16,8"/>
            <Button Content="Сохранить" Style="{StaticResource AccentButton}" Click="BtnSave_Click"/>
            <Button Content="Отмена" IsCancel="True" Margin="0,0,0,8"/>
        </StackPanel>
    </Grid>
</Window>
