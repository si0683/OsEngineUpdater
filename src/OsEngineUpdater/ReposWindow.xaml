<Window x:Class="OsEngineUpdater.ReposWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OsEngineUpdater"
        Title="Мои аккаунты и репозитории" Width="1040" Height="880" MinWidth="880" MinHeight="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI" FontSize="13" Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- аккаунты -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Мои аккаунты" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Dim}" Margin="0,0,0,10"
                           Text="Подключите GitHub, GitFlic или оба сразу: все репозитории аккаунтов появятся в окнах «Выбрать робот / индикатор / Свои файлы»."/>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Dim}" Margin="0,10,0,0"
                           Text="Токены хранятся зашифрованными для вашей учётной записи Windows."/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <local:AccountBlock x:Name="BlockGitHub" Changed="Block_Changed"/>
                        <local:AccountBlock x:Name="BlockGitFlic" Changed="Block_Changed" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- отдельные репозитории -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="90"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Отдельные репозитории" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" Style="{StaticResource Dim}" Margin="0,0,0,10"
                           Text="Нужны редко: чужой репозиторий, репозиторий с другого git-сервера или ещё один аккаунт."/>

                <Grid Grid.Row="2">
                    <TextBlock x:Name="TxtListEmpty" Style="{StaticResource Dim}" FontSize="13" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"
                               Text="Пока нет. Всё из ваших аккаунтов и так видно в окнах выбора."/>
                    <ListBox x:Name="EntriesList" SelectionChanged="EntriesList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Accent}" FontSize="12"/>
                                    <TextBlock Text="{Binding Url}" Style="{StaticResource Dim}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Добавить" Click="BtnAdd_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnRemove" Content="Удалить из списка" Click="BtnRemove_Click" Margin="0"/>
                </StackPanel>

                <Grid Grid.Row="4" x:Name="FormGrid" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Адрес" Style="{StaticResource Label}"/>
                    <TextBox Grid.Column="1" x:Name="TxtUrl" TextChanged="Form_Changed"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Dim}" Margin="0,4,0,0"
                               Text="Например: https://github.com/si0683/TemplateRobotScreenerSL"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtDetected" Margin="0,4,0,0" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="3" Text="Токен" Style="{StaticResource Label}" Margin="0,10,10,0"/>
                    <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="PwdToken" Margin="0,10,0,0" PasswordChanged="Form_Changed"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,4,0,0">
                        <TextBlock x:Name="TxtTokenHint" Style="{StaticResource Dim}"/>
                        <Button x:Name="BtnHowToken" Style="{StaticResource LinkButton}" Click="BtnHowToken_Click" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- инструкция: где взять токен -->
                    <Border Grid.Row="5" Grid.ColumnSpan="2" x:Name="PanelHowToken" Visibility="Collapsed" Margin="0,8,0,0"
                            Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="12,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="BtnOpenTokenPage" Click="BtnOpenTokenPage_Click" Margin="0,0,8,0"/>
                                <Button x:Name="BtnOpenTokenPage2" Click="BtnOpenTokenPage_Click" Margin="0" Visibility="Collapsed"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150">
                                <TextBlock x:Name="TxtHowToken" TextWrapping="Wrap" LineHeight="20"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <TextBlock Grid.Row="6" x:Name="LblBranch" Text="Ветка" Style="{StaticResource Label}" Margin="0,10,10,0"/>
                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtBranch" Margin="0,10,0,0" TextChanged="Form_Changed"
                             ToolTip="Пусто — ветка по умолчанию"/>

                    <DockPanel Grid.Row="7" Grid.ColumnSpan="2" Margin="0,12,0,0">
                        <Button DockPanel.Dock="Left" x:Name="BtnTest" Content="Проверить" Click="BtnTest_Click" Margin="0,0,10,0" VerticalAlignment="Top"/>
                        <TextBlock x:Name="TxtTest" VerticalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- обновление самой программы -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Обновление программы" Style="{StaticResource H2}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ChkSelfUpdate" Content="Обновлять OsEngine Updater автоматически, проверять" Click="SelfSetting_Changed"/>
                        <ComboBox x:Name="CmbSelfMinutes" Width="104" Margin="10,0,0,0" SelectionChanged="SelfSetting_Changed">
                            <ComboBoxItem Tag="10" Content="10 мин"/>
                            <ComboBoxItem Tag="30" Content="30 мин"/>
                            <ComboBoxItem Tag="60" Content="час"/>
                            <ComboBoxItem Tag="360" Content="6 часов"/>
                            <ComboBoxItem Tag="1440" Content="сутки"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock x:Name="TxtSelfInfo" Style="{StaticResource Dim}" Margin="0,8,0,0"/>
                    <TextBlock x:Name="TxtSelfStatus" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="BtnSelfCheck" Content="Проверить сейчас" Click="BtnSelfCheck_Click" Margin="0,0,0,6"/>
                    <Button x:Name="BtnSelfInstall" Content="Обновить и перезапустить" Style="{StaticResource AccentButton}"
                            Click="BtnSelfInstall_Click" Visibility="Collapsed" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="TxtGit" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,16,8"/>
            <Button Content="Сохранить" Style="{StaticResource AccentButton}" Click="BtnSave_Click"/>
            <Button Content="Отмена" IsCancel="True" Margin="0,0,0,8"/>
        </StackPanel>
    </Grid>
</Window>
