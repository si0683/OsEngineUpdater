<Window x:Class="OsEngineUpdater.ReposWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мои аккаунты и репозитории" Width="980" Height="780" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI" FontSize="13" Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- список -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Аккаунты и репозитории" Style="{StaticResource H2}"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Добавить" Click="BtnAdd_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnRemove" Content="Удалить из списка" Click="BtnRemove_Click" Margin="0"/>
                </StackPanel>
                <ListBox x:Name="EntriesList" SelectionChanged="EntriesList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Accent}" FontSize="12"/>
                                <TextBlock Text="{Binding Url}" Style="{StaticResource Dim}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- форма -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Запись" Style="{StaticResource H2}"/>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Dim}" Margin="0,10,0,0"
                           Text="Тип установки (робот, индикатор, свои файлы) выбирается кнопками «Выбрать робот / индикатор / Свои файлы» в главном окне — там же можно отметить отдельные файлы репозитория. Токен хранится зашифрованным для вашей учётной записи Windows."/>
                <Grid x:Name="FormGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Адрес" Style="{StaticResource Label}"/>
                    <TextBox Grid.Column="1" x:Name="TxtUrl" TextChanged="Form_Changed"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Dim}" Margin="0,4,0,0"
                               Text="Аккаунт: https://github.com/si0683 или https://gitflic.ru/user/si0683&#x0a;Один репозиторий: https://github.com/si0683/TemplateRobotScreenerSL"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtDetected" Margin="0,6,0,0" Foreground="{StaticResource Accent}"/>

                    <TextBlock Grid.Row="3" Text="Токен" Style="{StaticResource Label}" Margin="0,12,10,0"/>
                    <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="PwdToken" Margin="0,12,0,0" PasswordChanged="Form_Changed"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,4,0,0">
                        <TextBlock x:Name="TxtTokenHint" Style="{StaticResource Dim}"/>
                        <Button x:Name="BtnHowToken" Click="BtnHowToken_Click" HorizontalAlignment="Left" Margin="0,4,0,0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="{StaticResource Accent}" TextDecorations="Underline"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="T" Property="Foreground" Value="{StaticResource AccentHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Row="5" x:Name="LblBranch" Text="Ветка" Style="{StaticResource Label}" Margin="0,12,10,0"/>
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtBranch" Margin="0,12,0,0" TextChanged="Form_Changed"
                             ToolTip="Пусто — ветка по умолчанию"/>

                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="BtnTest" Content="Проверить" Click="BtnTest_Click"/>
                        <TextBlock x:Name="TxtTest" VerticalAlignment="Center" Margin="4,0,0,8" TextWrapping="Wrap" MaxWidth="340"/>
                    </StackPanel>

                    <!-- инструкция: где взять токен -->
                    <Border Grid.Row="7" Grid.ColumnSpan="2" x:Name="PanelHowToken" Visibility="Collapsed" Margin="0,8,0,0"
                            Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="12,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="BtnOpenTokenPage" Click="BtnOpenTokenPage_Click" Margin="0,0,8,0"/>
                                <Button x:Name="BtnOpenTokenPage2" Click="BtnOpenTokenPage_Click" Margin="0" Visibility="Collapsed"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="TxtHowToken" TextWrapping="Wrap" LineHeight="20"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="TxtGit" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,16,8"/>
            <Button Content="Сохранить" Style="{StaticResource AccentButton}" Click="BtnSave_Click"/>
            <Button Content="Отмена" IsCancel="True" Margin="0,0,0,8"/>
        </StackPanel>
    </Grid>
</Window>
