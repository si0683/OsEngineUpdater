<Window x:Class="OsEngineUpdater.PackagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбрать" Width="860" Height="640" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI" FontSize="13" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,10">
            <TextBlock x:Name="TxtTitle" Style="{StaticResource H2}" FontSize="16" Margin="0"/>
            <TextBlock x:Name="TxtSubtitle" Style="{StaticResource Dim}" Margin="0,2,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <ListBox x:Name="RowsList">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Url}" Style="{StaticResource Dim}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Target}" Style="{StaticResource Dim}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding StatusBrush}"
                                           VerticalAlignment="Center" TextAlignment="Right" Margin="12,0,4,0" MaxWidth="260" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="TxtEmpty" Visibility="Collapsed" Style="{StaticResource Dim}" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="20"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,12,0,4">
            <Button x:Name="BtnClose" DockPanel.Dock="Right" Content="Закрыть" IsCancel="True" Margin="0,0,0,8"/>
            <WrapPanel>
                <Button x:Name="BtnInstall" Content="Установить / обновить отмеченные" Style="{StaticResource AccentButton}" Click="BtnInstall_Click"/>
                <Button x:Name="BtnUninstall" Content="Удалить из копии отмеченные" Click="BtnUninstall_Click"/>
                <Button x:Name="BtnRepos" Content="Мои репозитории…" Click="BtnRepos_Click"/>
            </WrapPanel>
        </DockPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
            <TextBox x:Name="TxtLog" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0" Background="{StaticResource Panel}"/>
        </Border>
    </Grid>
</Window>
