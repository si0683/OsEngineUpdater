<Window x:Class="OsEngineUpdater.PackagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OsEngineUpdater"
        Title="Выбрать" Width="1120" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/app.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI" FontSize="13" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="130"/>
        </Grid.RowDefinitions>

        <!-- заголовок -->
        <DockPanel Margin="0,0,0,10">
            <StackPanel x:Name="PanelFilesTarget" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Куда в копии:" Style="{StaticResource Label}"/>
                <TextBox x:Name="TxtFilesTarget" Width="260" TextChanged="TxtFilesTarget_TextChanged"
                         ToolTip="Папка относительно корня копии. Структура папок репозитория сохраняется"/>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="TxtTitle" Style="{StaticResource H2}" FontSize="16" Margin="0"/>
                <TextBlock x:Name="TxtSubtitle" Style="{StaticResource Dim}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- репозитории -->
            <Border Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" x:Name="BtnReload" Content="⟳" ToolTip="Обновить список" Click="BtnReload_Click"
                                Margin="6,0,0,0" Padding="10,2" MinHeight="28"/>
                        <TextBox x:Name="TxtSearch" TextChanged="TxtSearch_TextChanged" ToolTip="Поиск по имени"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="TxtReposInfo" Style="{StaticResource Dim}" Margin="2,0,0,8"/>
                    <Grid>
                        <ListBox x:Name="ReposList" SelectionChanged="ReposList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="2,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                                <Run Text="{Binding PrivateMark, Mode=OneWay}" Foreground="{StaticResource FgDim}" FontWeight="Normal" FontSize="11"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Origin}" Style="{StaticResource Dim}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="TxtEmpty" Visibility="Collapsed" Style="{StaticResource Dim}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="16"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- файлы -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="BtnAll" Content="Все" Click="BtnAll_Click" Margin="0,0,6,0" Padding="10,2" MinHeight="26"/>
                            <Button x:Name="BtnNone" Content="Ничего" Click="BtnNone_Click" Margin="0" Padding="10,2" MinHeight="26"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtFilesTitle" Style="{StaticResource H2}" FontSize="14" Margin="0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="TxtFilesInfo" Style="{StaticResource Dim}" Margin="2,0,0,8"/>
                    <Grid>
                        <TreeView x:Name="FilesTree" Background="Transparent" BorderThickness="0">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TreeViewItem">
                                                <StackPanel>
                                                    <Grid Background="Transparent">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ToggleButton x:Name="Expander" Focusable="False" ClickMode="Press"
                                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Background="Transparent" Width="20" Height="20" Cursor="Hand">
                                                                        <Path x:Name="Arrow" Data="M2,0 L6,4 L2,8" Stroke="{StaticResource FgDim}" StrokeThickness="1.5"
                                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="Arrow" Property="Data" Value="M0,2 L4,6 L8,2"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ContentPresenter Grid.Column="1" ContentSource="Header"/>
                                                    </Grid>
                                                    <ItemsPresenter x:Name="ItemsHost" Margin="20,0,0,0"/>
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsExpanded" Value="False">
                                                        <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                    <Trigger Property="HasItems" Value="False">
                                                        <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type local:FileNode}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        <Path x:Name="Ico" Style="{StaticResource ItemIcon}" Margin="8,0,6,0"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <HierarchicalDataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDir}" Value="True">
                                            <Setter TargetName="Ico" Property="Data" Value="{StaticResource IconFolder}"/>
                                        </DataTrigger>
                                    </HierarchicalDataTemplate.Triggers>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <TextBlock x:Name="TxtFilesEmpty" Style="{StaticResource Dim}" FontSize="13" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                                   Text="Нажмите на репозиторий слева, чтобы увидеть его файлы и выбрать нужные.&#x0a;Целиком робот или индикатор ставится как git-репозиторий: можно дорабатывать и делать commit/push из Visual Studio. Выбранные отдельные файлы просто копируются."/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,12,0,4">
            <Button x:Name="BtnClose" DockPanel.Dock="Right" Content="Закрыть" IsCancel="True" Margin="0,0,0,8"/>
            <WrapPanel>
                <Button x:Name="BtnInstall" Content="Установить / обновить отмеченные" Style="{StaticResource AccentButton}" Click="BtnInstall_Click"/>
                <Button x:Name="BtnUninstall" Content="Удалить из копии отмеченные" Click="BtnUninstall_Click"/>
                <Button x:Name="BtnRepos" Content="Мои аккаунты и репозитории…" Click="BtnRepos_Click"/>
            </WrapPanel>
        </DockPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
            <TextBox x:Name="TxtLog" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0" Background="{StaticResource Panel}"/>
        </Border>
    </Grid>
</Window>
